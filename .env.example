# Development: npm start. For an isolated sample-data demo: npm run demo.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development

# Default false: forwarded headers are ignored. Enable only behind same-host
# Nginx that overwrites X-Real-IP with $remote_addr; keep Node on loopback.
# The Oracle systemd service template enables this after that proxy setup.
TRUST_PROXY_LOOPBACK=false

# Numeric Twitch ID of the service owner. Never a username.
OWNER_TWITCH_ID=

# Register exact callbacks: PUBLIC_BASE_URL/auth/{provider}/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Upload scanning (optional; see docs/OPERATIONS.md). Every upload is decoded
# and rebuilt regardless. CLAMD_SOCKET (or CLAMD_HOST/CLAMD_PORT) sends the
# original file to ClamAV; CONTENT_SCAN_URL posts the rebuilt image to a
# classifier that answers {"verdict":"allow"|"review"|"block"}.
CLAMD_SOCKET=
CLAMD_HOST=
CLAMD_PORT=3310
CONTENT_SCAN_URL=
CONTENT_SCAN_TOKEN=
# closed (default): refuse uploads while a configured scanner is down.
# review: accept them, flagged for moderators.
SCAN_FAIL_MODE=closed

# Cloudflare edge cache (optional; see docs/OPERATIONS.md). Set both or neither.
# With them, approved textures are cached at Cloudflare and purged when a Flare
# is disapproved, banned or deleted; the change feed is cached for EDGE_FEED_TTL
# seconds. The token needs only Zone > Cache Purge > Purge on this zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
# Edge lifetime of an approved texture in seconds (60 to 31536000). Purges
# normally end it sooner; this bounds how long a failed purge can leave one up.
EDGE_TEXTURE_TTL=86400
# Edge lifetime of a change-feed answer in seconds (0 turns it off, max 10).
EDGE_FEED_TTL=2

# Change-feed pacing (see docs/OPERATIONS.md). Overlays are asked to poll less
# often once more than FEED_POLL_TARGET_RPS polls a second would arrive at 4s,
# up to FEED_POLL_MAX_MS (4000-30000). NGINX_STATUS_URL lets pacing count the
# overlays nginx's micro-cache answers; the Oracle template serves it here.
FEED_POLL_TARGET_RPS=100
FEED_POLL_MAX_MS=15000
NGINX_STATUS_URL=

# Where `npm run backup` writes snapshots (docs/OPERATIONS.md).
BACKUP_DIR=./backups

# Public repository URL; lets hosted users obtain corresponding source (AGPL).
SOURCE_URL=https://github.com/b-x-n-e/nameflare
