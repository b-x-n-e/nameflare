# Development: npm start. For an isolated sample-data demo: npm run demo.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development

# Default false: forwarded headers are ignored. Enable only behind same-host
# Nginx that overwrites X-Real-IP with $remote_addr; keep Node on loopback.
# The Oracle systemd service template enables this after that proxy setup.
TRUST_PROXY_LOOPBACK=false

# Numeric Twitch ID of the service owner. Never a username.
OWNER_TWITCH_ID=

# Register exact callbacks: PUBLIC_BASE_URL/auth/{provider}/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Upload scanning (optional; see docs/OPERATIONS.md). Every upload is decoded
# and rebuilt regardless. CLAMD_SOCKET (or CLAMD_HOST/CLAMD_PORT) sends the
# original file to ClamAV; CONTENT_SCAN_URL posts the rebuilt image to a
# classifier that answers {"verdict":"allow"|"review"|"block"}.
CLAMD_SOCKET=
CLAMD_HOST=
CLAMD_PORT=3310
CONTENT_SCAN_URL=
CONTENT_SCAN_TOKEN=
# closed (default): refuse uploads while a configured scanner is down.
# review: accept them, flagged for moderators.
SCAN_FAIL_MODE=closed

# Where `npm run backup` writes snapshots (docs/OPERATIONS.md).
BACKUP_DIR=./backups

# Public repository URL; lets hosted users obtain corresponding source (AGPL).
SOURCE_URL=https://github.com/b-x-n-e/nameflare
